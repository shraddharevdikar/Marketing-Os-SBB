rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Security & Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Tenant / Organization Membership Verification
    // CRITICAL: Self-assignment prevention.
    // Membership is ONLY granted if verified by trusted token custom claims
    // OR if an established record exists in organizations/{orgId}/members/{uid} provisioned by an Org Admin.
    // A user document's unverified organizationId field is NEVER trusted for membership.
    function isOrgMember(orgId) {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.organizationId == orgId) ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
    }

    function isOrgAdmin(orgId) {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.role == 'Admin' && request.auth.token.organizationId == orgId) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // 1. User Profiles: Isolated to owner or verified organization administrators.
    // Prevents self-assigned organisation membership and role escalation.
    match /users/{userId} {
      allow read: if isOwner(userId) || (
        isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId)
      );
      
      // On creation: callers can only assign unprivileged baseline role ('Executive')
      // and cannot attach arbitrary production organizationIds without verified token claim.
      allow create: if isOwner(userId) && (
        (!('role' in request.resource.data) || request.resource.data.role == 'Executive') &&
        (!('organizationId' in request.resource.data) || 
         request.resource.data.organizationId == 'synthetic_sandbox' || 
         (request.auth.token != null && request.auth.token.organizationId == request.resource.data.organizationId))
      );

      // On update: callers cannot modify their role or their organizationId.
      // Role changes and tenant migrations require trusted admin provisioning.
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role && 
        request.resource.data.organizationId == resource.data.organizationId
      );

      allow delete: if isOwner(userId) || (
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId)
      );
    }

    // 2. Organizations & Tenant Hierarchy
    // Disallows unconstrained self-creation of organizations.
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isOrgAdmin(orgId);
      allow update, delete: if isOrgAdmin(orgId);

      // Members subcollection: ONLY verified Org Admins can add members or alter roles.
      // Self-membership creation is strictly prohibited.
      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // Tenant-scoped Company Profile (Only Org Admin can modify corporate settings)
      match /company_profile/{profileId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      // Tenant-scoped Campaigns
      // Consequential execution fields and approval states cannot be altered directly by clients
      match /campaigns/{campaignId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) &&
          (!('organizationId' in request.resource.data) || request.resource.data.organizationId == orgId) &&
          (!('status' in request.resource.data) || request.resource.data.status != 'EXECUTED') &&
          (!('approved' in request.resource.data) || request.resource.data.approved == false);
        allow update: if isOrgMember(orgId) &&
          (!('organizationId' in request.resource.data) || request.resource.data.organizationId == resource.data.organizationId) &&
          (!('approved' in request.resource.data) || request.resource.data.approved == resource.data.approved) &&
          (!('approvalGateId' in request.resource.data) || request.resource.data.approvalGateId == resource.data.approvalGateId) &&
          (!('status' in request.resource.data) || resource.data.status != 'EXECUTED' || request.resource.data.status == resource.data.status);
        allow delete: if isOrgAdmin(orgId);
      }

      // Tenant-scoped Leads
      match /leads/{leadId} {
        allow read, create: if isOrgMember(orgId);
        allow update: if isOrgMember(orgId);
        allow delete: if isOrgAdmin(orgId);
      }

      // Tenant-scoped Immutable Audit Logs
      // Ordinary members cannot forge or create audit entries; all audit logs originate from authenticated backend
      match /audit_logs/{logId} {
        allow read: if isOrgMember(orgId);
        allow write: if false; // Compliance: client writes strictly prohibited
      }

      // Tenant-scoped AI Creatives & Assets
      match /ai_creatives/{assetId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgMember(orgId) && (
          resource.data.userId == request.auth.uid || 
          isOrgAdmin(orgId)
        );
      }

      // Tenant-scoped Approval Gates
      // Consequential approval records cannot be directly approved, rejected, or altered by clients.
      // All approval state transitions MUST route through authenticated backend endpoints.
      match /approval_gates/{gateId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) &&
          request.resource.data.status == 'PENDING_APPROVAL' &&
          request.resource.data.requestedBy == request.auth.uid &&
          !('decidedBy' in request.resource.data) &&
          !('decidedAt' in request.resource.data) &&
          !('executedBy' in request.resource.data) &&
          !('executedAt' in request.resource.data);
        allow update, delete: if false; // State transitions strictly route through backend
      }
    }

    // 3. Top-Level Collections: STRICTLY REQUIRE valid organizationId.
    // Records without organizationId are disallowed to eliminate cross-tenant leakage.
    match /company_profiles/{profileId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn() && 
        request.resource.data.organizationId != null && 
        isOrgAdmin(request.resource.data.organizationId);
      allow update: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId);
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn() && 
        request.resource.data.organizationId != null && 
        isOrgMember(request.resource.data.organizationId) &&
        (!('status' in request.resource.data) || request.resource.data.status != 'EXECUTED') &&
        (!('approved' in request.resource.data) || request.resource.data.approved == false);
      allow update: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        (!('approved' in request.resource.data) || request.resource.data.approved == resource.data.approved) &&
        (!('approvalGateId' in request.resource.data) || request.resource.data.approvalGateId == resource.data.approvalGateId) &&
        (!('status' in request.resource.data) || resource.data.status != 'EXECUTED' || request.resource.data.status == resource.data.status);
      allow delete: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId);
    }

    match /leads/{leadId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn() && 
        request.resource.data.organizationId != null && 
        isOrgMember(request.resource.data.organizationId);
      allow update: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgAdmin(resource.data.organizationId);
    }

    match /approval_gates/{gateId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn() && 
        request.resource.data.organizationId != null && 
        isOrgMember(request.resource.data.organizationId) &&
        request.resource.data.status == 'PENDING_APPROVAL' &&
        request.resource.data.requestedBy == request.auth.uid &&
        !('decidedBy' in request.resource.data) &&
        !('decidedAt' in request.resource.data);
      allow update, delete: if false; // State transitions strictly route through backend
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow write: if false; // Audit logs are strictly appended server-side
    }

    match /ai_creatives/{assetId} {
      allow read: if isSignedIn() && 
        resource.data.organizationId != null && 
        isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn() && 
        request.resource.data.organizationId != null && 
        request.resource.data.userId == request.auth.uid &&
        isOrgMember(request.resource.data.organizationId);
      allow update: if isSignedIn() && 
        resource.data.organizationId != null && 
        resource.data.userId == request.auth.uid &&
        isOrgMember(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && 
        resource.data.organizationId != null && 
        resource.data.userId == request.auth.uid &&
        isOrgMember(resource.data.organizationId);
    }
  }
}
